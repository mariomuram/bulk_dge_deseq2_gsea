conda: "envs/base.yaml"

import parse
import re
import pandas as pd
import yaml
from pathlib import Path

# Load configuration
configfile: "config/config.yaml"

OUTPUT_DIR = config["output_dir"]
SAMPLES_INFO = config["samples"]
DESIGN = config["design"]
DESIGN_FORMULA = DESIGN["formula"]
LABEL_PATTERN = config["sample_label_pattern"]

# --- Parse every sample label into its fields -----------------------

LABEL_PARSER = parse.compile(LABEL_PATTERN)
SAMPLE_FIELDS = {}
for sample, label in SAMPLES_INFO.items():
  result = LABEL_PARSER.parse(label)
  if result is None:
    raise ValueError(
      f"Sample '{sample}' has label '{label}', which does not "
      f"match sample_label_pattern '{LABEL_PATTERN}'."
    )
  fields = result.named
  reconstructed = LABEL_PATTERN.format(**fields)
  if reconstructed != label:
    raise ValueError(
      f"Sample '{sample}': parsing '{label}' with pattern "
      f"'{LABEL_PATTERN}' gave fields {fields}, which do not "
      f"reconstruct the original label ('{reconstructed}'). "
      "A field value likely contains the pattern's own "
      "separator; check for an ambiguous split."
    )
  SAMPLE_FIELDS[sample] = fields

FIELD_NAMES = list(next(iter(SAMPLE_FIELDS.values())).keys())

# --- Validate design.formula only references parsed fields ----------

formula_tokens = set(re.findall(r"[A-Za-z_]\w*", DESIGN_FORMULA))
unknown_fields = formula_tokens - set(FIELD_NAMES)
if unknown_fields:
  raise ValueError(
    f"design.formula references field(s) not produced by "
    f"sample_label_pattern: {sorted(unknown_fields)}. Parsed "
    f"fields are: {FIELD_NAMES}."
  )

# --- Validate reference_levels field names, then resolve defaults ---

configured_ref_levels = DESIGN.get("reference_levels", {})
unknown_ref_fields = set(configured_ref_levels) - set(FIELD_NAMES)
if unknown_ref_fields:
  raise ValueError(
    f"design.reference_levels references field(s) not produced "
    f"by sample_label_pattern: {sorted(unknown_ref_fields)}."
  )

REFERENCE_LEVELS = {}
for field in sorted(formula_tokens):
  observed = sorted({v[field] for v in SAMPLE_FIELDS.values()})
  REFERENCE_LEVELS[field] = configured_ref_levels.get(field, observed[0])

# --- Resolve contrasts: numerator/denominator sugar -> groups -------

ALL_CONDITIONS = set(SAMPLES_INFO.values())
CONTRASTS = {}
for name, spec in config["contrasts"].items():
  groups = spec["groups"] if "groups" in spec else {
    spec["numerator"]: 1, spec["denominator"]: -1
  }
  unknown = set(groups) - ALL_CONDITIONS
  if unknown:
    raise ValueError(
      f"Contrast '{name}' references condition(s) not present "
      f"in config.yaml 'samples': {sorted(unknown)}. Available: "
      f"{sorted(ALL_CONDITIONS)}."
    )
  CONTRASTS[name] = groups

CONTRAST_NAMES = list(CONTRASTS.keys())
GSEA_NAMES = list(config["gsea"].keys())

wildcard_constraints:
  contrast = "|".join(re.escape(c) for c in CONTRAST_NAMES),
  gsea = "|".join(re.escape(a) for a in GSEA_NAMES),

rule all:
  input:
    # DESeq2 results
    f"{OUTPUT_DIR}/deseq2/dds_object.rds",
    expand(
      f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
      contrast=CONTRAST_NAMES
    ),
    # QC plots
    f"{OUTPUT_DIR}/qc/pca.pdf",
    expand(
      f"{OUTPUT_DIR}/qc/{{contrast}}_{{plot}}.pdf",
      contrast=CONTRAST_NAMES,
      plot=["ma_plot", "volcano_plot"]
    ),
    # GSEA results
    expand(
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea.tsv.gz",
      contrast=CONTRAST_NAMES, gsea=GSEA_NAMES
    ),
    expand(
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_plot.pdf",
      contrast=CONTRAST_NAMES, gsea=GSEA_NAMES
    ),

rule deseq2_fit:
  input: counts = "data/quantification/star_rsem/rsem.merged.gene_counts.tsv",
  params:
    samples_info = SAMPLES_INFO,
    design_formula = DESIGN_FORMULA,
    sample_fields = SAMPLE_FIELDS,
    reference_levels = REFERENCE_LEVELS,
  output: dds_rds = f"{OUTPUT_DIR}/deseq2/dds_object.rds",
  log: f"{OUTPUT_DIR}/logs/deseq2_fit.log"
  conda: "envs/deseq2.yaml"
  script: "scripts/deseq2_fit.R"

rule deseq2_contrast:
  input: dds_rds = rules.deseq2_fit.output.dds_rds,
  params:
    groups = lambda wc: CONTRASTS[wc.contrast],
    padj_threshold = config["deseq2"]["padj_threshold"],
    log2fc_threshold = config["deseq2"].get("log2fc_threshold", 0.0),
  output: results = f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
  log: f"{OUTPUT_DIR}/logs/deseq2_contrast_{{contrast}}.log"
  conda: "envs/deseq2.yaml"
  script: "scripts/deseq2_contrast.R"

rule qc_pca:
  input: dds_rds = rules.deseq2_contrast.input.dds_rds,
  output: pca = f"{OUTPUT_DIR}/qc/pca.pdf",
  log: f"{OUTPUT_DIR}/logs/qc_pca.log"
  conda: "envs/qc_pca.yaml"
  script: "scripts/qc_pca.R"

rule qc_volcano:
  input: results = rules.deseq2_contrast.output.results,
  params:
    contrast_name = "{contrast}",
    padj_threshold = config["deseq2"]["padj_threshold"],
    log2fc_threshold = config["deseq2"].get("log2fc_threshold", 0.0),
  output: volcano = f"{OUTPUT_DIR}/qc/{{contrast}}_volcano_plot.pdf",
  log: f"{OUTPUT_DIR}/logs/qc_volcano_{{contrast}}.log"
  conda: "envs/qc_volcano.yaml"
  script: "scripts/qc_volcano.R"

rule qc_ma:
  input: results = rules.deseq2_contrast.output.results,
  params:
    contrast_name = "{contrast}",
    padj_threshold = config["deseq2"]["padj_threshold"],
  output: ma = f"{OUTPUT_DIR}/qc/{{contrast}}_ma_plot.pdf",
  log: f"{OUTPUT_DIR}/logs/qc_ma_{{contrast}}.log"
  conda: "envs/qc_ma.yaml"
  script: "scripts/qc_ma.R"

rule gsea:
  input: results = f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
  params:
    contrast_name = "{contrast}",
    gsea_name = "{gsea}",
    gsea_config = lambda wc: config["gsea"][wc.gsea],
  output:
    gsea_table = f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea.tsv.gz",
    gsea_plot = f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_plot.pdf",
  log: f"{OUTPUT_DIR}/logs/gsea_{{contrast}}_{{gsea}}.log"
  conda: "envs/gsea.yaml"
  script: "scripts/gsea.R"
