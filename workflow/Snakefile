#conda: "envs/base.yaml"

import pandas as pd
import yaml
from pathlib import Path

# Load configuration
configfile: "config/config.yaml"

OUTPUT_DIR = config["output_dir"]
SAMPLES_INFO = config["samples"]
DESIGNS = config["designs"]
DESIGN_NAMES = list(DESIGNS.keys())

# Flatten contrasts across designs, tracking provenance so a
# contrast result can be traced back to the dds fit it needs.
CONTRAST_TO_DESIGN = {}
for design_name, design in DESIGNS.items():
  for contrast_name in design["contrasts"]:
    if contrast_name in CONTRAST_TO_DESIGN:
      other = CONTRAST_TO_DESIGN[contrast_name]
      raise ValueError(
        f"Contrast '{contrast_name}' is defined in both designs "
        f"'{other}' and '{design_name}'. Contrast names must be "
        "unique across all designs."
      )
    CONTRAST_TO_DESIGN[contrast_name] = design_name

CONTRAST_NAMES = list(CONTRAST_TO_DESIGN.keys())

wildcard_constraints:
  design = "|".join(re.escape(d) for d in DESIGN_NAMES),
  contrast = "|".join(re.escape(c) for c in CONTRAST_NAMES),

rule all:
  input:
    # DESeq2 results
    expand(
      f"{OUTPUT_DIR}/deseq2/dds_object_{{design}}.rds",
      design=DESIGN_NAMES
    ),
    expand(
      f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
      contrast=CONTRAST_NAMES
    ),
    # QC plots
    f"{OUTPUT_DIR}/qc/pca.pdf",
    expand(
      f"{OUTPUT_DIR}/qc/{{contrast}}_{{plot}}.pdf",
      contrast=CONTRAST_NAMES,
      plot=["ma_plot", "volcano_plot"]
    ),
    # GSEA results
    expand(
      f"{OUTPUT_DIR}/gsea/{{contrast}}_gsea.tsv.gz",
      contrast=CONTRAST_NAMES
    ),
    expand(
      f"{OUTPUT_DIR}/gsea/{{contrast}}_gsea_plot.pdf",
      contrast=CONTRAST_NAMES
    ),

rule deseq2_fit:
  input: counts = "data/quantification/star_rsem/rsem.merged.gene_counts.tsv",
  params:
    samples_info = SAMPLES_INFO,
    design_formula = lambda wc: DESIGNS[wc.design]["formula"],
  output: dds_rds = f"{OUTPUT_DIR}/deseq2/dds_object_{{design}}.rds",
  log: f"{OUTPUT_DIR}/logs/deseq2_fit_{{design}}.log"
  conda: "envs/deseq2.yaml"
  script: "scripts/deseq2_fit.R"

def _dds_for_design(design):
  return f"{OUTPUT_DIR}/deseq2/dds_object_{design}.rds"

def _dds_for_contrast(wildcards):
  design = CONTRAST_TO_DESIGN[wildcards.contrast]
  return _dds_for_design(design)

rule deseq2_contrast:
  input: dds_rds = _dds_for_contrast,
  params:
    contrast = lambda wc: (
      DESIGNS[CONTRAST_TO_DESIGN[wc.contrast]]["contrasts"][wc.contrast]
    ),
    padj_threshold = config["deseq2"]["padj_threshold"],
    log2fc_threshold = config["deseq2"].get("log2fc_threshold", 0.0),
  output: results = f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
  log: f"{OUTPUT_DIR}/logs/deseq2_contrast_{{contrast}}.log"
  conda: "envs/deseq2.yaml"
  script: "scripts/deseq2_contrast.R"

