conda: "envs/base.yaml"

import parse
import re
import pandas as pd
import yaml
from pathlib import Path
import itertools

# Load configuration
configfile: "config/config.yaml"

OUTPUT_DIR = config["output_dir"]
DESIGN = config["design"]
LABEL_PATTERN = config["sample_label_pattern"]

# --- Parse the new files structure and flatten samples ---------------

FILES = config["files"]  # dict of {file_key: {path: ..., samples: {...}}}

# Flatten back to SAMPLES_INFO and track file origins
SAMPLES_INFO = {}
SAMPLE_TO_FILE = {}
FILE_TO_SAMPLES = {}

for file_key, file_info in FILES.items():
  file_path = file_info["path"]
  file_samples = file_info["samples"]

  for sample_id, label in file_samples.items():
    # Check for duplicate sample IDs across files (hard error)
    if sample_id in SAMPLES_INFO:
      raise ValueError(
        f"Sample '{sample_id}' appears in multiple file groups: "
        f"previously in '{SAMPLE_TO_FILE[sample_id]['file_key']}', "
        f"now in '{file_key}'. Samples must be unique across all files."
      )
    SAMPLES_INFO[sample_id] = label
    SAMPLE_TO_FILE[sample_id] = {"file_key": file_key, "path": file_path}
    FILE_TO_SAMPLES[file_key] = {"path": file_path, "samples": file_samples}

# --- Parse every sample label into its fields -----------------------

LABEL_PARSER = parse.compile(LABEL_PATTERN)
SAMPLE_FIELDS = {}
for sample, label in SAMPLES_INFO.items():
  result = LABEL_PARSER.parse(label)
  if result is None:
    raise ValueError(
      f"Sample '{sample}' has label '{label}', which does not "
      f"match sample_label_pattern '{LABEL_PATTERN}'."
    )
  fields = result.named
  reconstructed = LABEL_PATTERN.format(**fields)
  if reconstructed != label:
    raise ValueError(
      f"Sample '{sample}': parsing '{label}' with pattern "
      f"'{LABEL_PATTERN}' gave fields {fields}, which do not "
      f"reconstruct the original label ('{reconstructed}'). "
      "A field value likely contains the pattern's own "
      "separator; check for an ambiguous split."
    )
  SAMPLE_FIELDS[sample] = fields

FIELD_NAMES = list(next(iter(SAMPLE_FIELDS.values())).keys())

# --- Resolve contrasts: numerator/denominator sugar -> groups -------

ALL_CONDITIONS = set(SAMPLES_INFO.values())
CONTRASTS = {}
for name, spec in config["contrasts"].items():
  groups = spec["groups"] if "groups" in spec else {
    spec["numerator"]: 1, spec["denominator"]: -1
  }
  unknown = set(groups) - ALL_CONDITIONS
  if unknown:
    raise ValueError(
      f"Contrast '{name}' references condition(s) not present "
      f"in config.yaml 'samples': {sorted(unknown)}. Available: "
      f"{sorted(ALL_CONDITIONS)}."
    )
  CONTRASTS[name] = groups

CONTRAST_NAMES = list(CONTRASTS.keys())
ALL_CONDITIONS = set(SAMPLES_INFO.values())
CONTRAST_SPECS = {}
for name, spec in config["contrasts"].items():
  if "numerator" in spec and "denominator" in spec:
    referenced = {spec["numerator"], spec["denominator"]}
    contrast_type = "pairwise"
  else:
    referenced = set(spec["groups"])
    contrast_type = "groups"

  unknown = referenced - ALL_CONDITIONS
  if unknown:
    raise ValueError(
      f"Contrast '{name}' references condition(s) not present "
      f"in config.yaml 'samples': {sorted(unknown)}. Available: "
      f"{sorted(ALL_CONDITIONS)}."
    )
  CONTRAST_SPECS[name] = {"type": contrast_type, **spec}

CONTRAST_NAMES = list(CONTRAST_SPECS.keys())

PAIRWISE_CONTRASTS = {
  n: s for n, s in CONTRAST_SPECS.items() if s["type"] == "pairwise"
}
REFERENCE_FACTORS = sorted({
  s["denominator"] for s in PAIRWISE_CONTRASTS.values()
})

configured_ref_levels = DESIGN.get("reference_levels", {})
unknown_ref_fields = set(configured_ref_levels) - set(FIELD_NAMES)
if unknown_ref_fields:
  raise ValueError(
    f"design.reference_levels references field(s) not produced "
    f"by sample_label_pattern: {sorted(unknown_ref_fields)}."
  )

REFERENCE_LEVELS = {}
for field in FIELD_NAMES:
  observed = sorted({v[field] for v in SAMPLE_FIELDS.values()})
  REFERENCE_LEVELS[field] = configured_ref_levels.get(field, observed[0])

# --- Build count file list for Snakemake dependency tracking -----------

COUNT_FILE_PATHS = sorted(
  set(file_info["path"] for file_info in FILES.values())
)

# --- Which coefficients actually exist, given the observed ------
# --- (possibly incomplete) factorial. ----------------------------

CONDITION_FIELDS = {
  cond: SAMPLE_FIELDS[sample] for sample, cond in SAMPLES_INFO.items()
}

def group_for(assignment):
  for cond, fields in CONDITION_FIELDS.items():
    if all(fields[f] == assignment[f] for f in FIELD_NAMES):
      return cond
  return None

def canonical_patterns():
  patterns = []
  for r in range(1, len(FIELD_NAMES) + 1):
    for term in itertools.combinations(FIELD_NAMES, r):
      non_ref_levels = {
        f: [v for v in sorted({fl[f] for fl in CONDITION_FIELDS.values()})
            if v != REFERENCE_LEVELS[f]]
        for f in term
      }
      for combo in itertools.product(*non_ref_levels.values()):
        chosen = dict(zip(term, combo))
        pattern, complete = {}, True
        for corner in itertools.product([False, True], repeat=len(term)):
          assignment = dict(REFERENCE_LEVELS)
          for f, at_chosen in zip(term, corner):
            assignment[f] = chosen[f] if at_chosen else REFERENCE_LEVELS[f]
          cond = group_for(assignment)
          if cond is None:
            complete = False
            break
          sign = (-1) ** (len(term) - sum(corner))
          pattern[cond] = pattern.get(cond, 0) + sign
        if complete:
          patterns.append(pattern)
  return patterns

_CANONICAL_PATTERNS = canonical_patterns()

def contrast_is_shrinkable(spec):
  if spec["type"] == "pairwise":
    return True
  return spec["groups"] in _CANONICAL_PATTERNS

SHRINKABLE_CONTRASTS = [
  name for name, spec in CONTRAST_SPECS.items()
  if contrast_is_shrinkable(spec)
]

GENES_OF_INTEREST = config.get("genes_of_interest", None)
GSEA_NAMES = list(config["gsea"].keys())
GO_GSEA_NAMES = [
    n for n in GSEA_NAMES if config["gsea"][n]["database"] == "GO"
]
OTHER_GSEA_NAMES = [
    n for n in GSEA_NAMES if config["gsea"][n]["database"] != "GO"
]

HEATMAP_TOP_N = config["gsea_summary"]["heatmap_top_n"]


wildcard_constraints:
  contrast = "|".join(re.escape(c) for c in CONTRAST_NAMES),
  reference_factor = "|".join(re.escape(r) for r in REFERENCE_FACTORS),
  lfc_type = "unshrunk|shrunk",
  gsea = "|".join(re.escape(a) for a in GSEA_NAMES),


rule all:
  input:
    # DESeq2 results
    f"{OUTPUT_DIR}/deseq2/dds_object.rds",
    expand(f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
           contrast=CONTRAST_NAMES),
    # QC plots
    f"{OUTPUT_DIR}/qc/pca.pdf",
    expand(f"{OUTPUT_DIR}/qc/{{contrast}}_{{plot}}_plot_{{lfc}}.pdf",
           contrast=CONTRAST_NAMES, plot = { "ma", "volcano" },
           lfc = { "shrunk", "unshrunk" }),
    # GSEA results
    expand(f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_{{table}}.tsv.gz",
           contrast=CONTRAST_NAMES, gsea=GSEA_NAMES,
           table = { "all", "signif", "driver_genes" }),
    expand(f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_signif_simplified.tsv.gz",
           contrast=CONTRAST_NAMES, gsea=GO_GSEA_NAMES),
    expand(f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_{{plot}}.pdf",
           contrast=CONTRAST_NAMES, gsea=GSEA_NAMES,
           plot = { "plot", "ridge_plot", "lollipop_plot" }),
    # GSEA summary results
    expand(f"{OUTPUT_DIR}/gsea/{{gsea}}_gsea_summary.tsv.gz", gsea=GSEA_NAMES),
    expand(f"{OUTPUT_DIR}/gsea/{{gsea}}_gsea_summary_heatmap.pdf",
           gsea=GSEA_NAMES),
    expand(f"{OUTPUT_DIR}/gsea/{{gsea}}_gsea_jaccard.tsv.gz",
           gsea=GSEA_NAMES),

rule deseq2_fit:
  input: count_files = COUNT_FILE_PATHS,
  params:
    samples_info = SAMPLES_INFO,
    sample_fields = SAMPLE_FIELDS,
    reference_levels = REFERENCE_LEVELS,
    file_to_samples = FILE_TO_SAMPLES,
  output: dds_rds = f"{OUTPUT_DIR}/deseq2/dds_object.rds",
  log: f"{OUTPUT_DIR}/logs/deseq2_fit.log"
  conda: "envs/deseq2_fit.yaml"
  script: "scripts/deseq2_fit.R"

def _dds_for_contrast(wildcards):
  spec = CONTRAST_SPECS[wildcards.contrast]
  if spec["type"] == "pairwise":
    denom = spec["denominator"]
    return f"{OUTPUT_DIR}/deseq2/dds_object_relevel_{denom}.rds"
  return rules.deseq2_fit.output.dds_rds

rule deseq2_relevel:
  input: dds_rds = f"{OUTPUT_DIR}/deseq2/dds_object.rds",
  params: reference_factor = "{reference_factor}",
  output:
    dds_rds =
      f"{OUTPUT_DIR}/deseq2/dds_object_relevel_{{reference_factor}}.rds",
  log: f"{OUTPUT_DIR}/logs/deseq2_relevel_{{reference_factor}}.log"
  conda: "envs/deseq2_relevel.yaml"
  script: "scripts/deseq2_relevel.R"

rule deseq2_contrast:
  input: dds_rds = _dds_for_contrast,
  params:
    contrast_spec = lambda wc: CONTRAST_SPECS[wc.contrast],
    padj_threshold = config["deseq2"]["padj_threshold"],
    log2fc_threshold = config["deseq2"].get("log2fc_threshold", 0.0),
    expected_shrinkable = lambda wc: wc.contrast in SHRINKABLE_CONTRASTS,
  output: results = f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
  log: f"{OUTPUT_DIR}/logs/deseq2_contrast_{{contrast}}.log"
  conda: "envs/deseq2_contrast.yaml"
  script: "scripts/deseq2_contrast.R"

rule qc_pca:
  input:
    dds_rds = rules.deseq2_fit.output.dds_rds,
    plot_theme_lib = workflow.source_path("scripts/lib/plot_theme.R"),
    # ^-- explicitly re-run upon code change
  output: pca = f"{OUTPUT_DIR}/qc/pca.pdf",
  log: f"{OUTPUT_DIR}/logs/qc_pca.log"
  conda: "envs/qc_pca.yaml"
  script: "scripts/qc_pca.R"

rule qc_volcano:
  input: results = rules.deseq2_contrast.output.results,
    qc_input_lib = workflow.source_path("scripts/lib/qc_input.R"),
    # ^-- explicitly re-run upon code change
    plot_theme_lib = rules.qc_pca.input.plot_theme_lib,
    # ^-- explicitly re-run upon code change
  params:
    contrast_name = "{contrast}",
    lfc_type = "{lfc_type}",
    padj_threshold = rules.deseq2_contrast.params.padj_threshold,
    log2fc_threshold = rules.deseq2_contrast.params.log2fc_threshold,
    genes_of_interest = GENES_OF_INTEREST,
  output:
    volcano = f"{OUTPUT_DIR}/qc/{{contrast}}_volcano_plot_{{lfc_type}}.pdf",
  log: f"{OUTPUT_DIR}/logs/qc_volcano_{{contrast}}_{{lfc_type}}.log"
  conda: "envs/qc_volcano.yaml"
  script: "scripts/qc_volcano.R"

rule qc_ma:
  input:
    results = rules.deseq2_contrast.output.results,
    qc_input_lib = rules.qc_volcano.input.qc_input_lib,
    # ^-- explicitly re-run upon code change
    plot_theme_lib = rules.qc_volcano.input.plot_theme_lib,
    # ^-- explicitly re-run upon code change
  params:
    contrast_name = rules.qc_volcano.params.contrast_name,
    lfc_type = rules.qc_volcano.params.lfc_type,
    padj_threshold = rules.qc_volcano.params.padj_threshold,
    genes_of_interest = rules.qc_volcano.params.genes_of_interest,
  output: ma = f"{OUTPUT_DIR}/qc/{{contrast}}_ma_plot_{{lfc_type}}.pdf",
  log: f"{OUTPUT_DIR}/logs/qc_ma_{{contrast}}_{{lfc_type}}.log"
  conda: "envs/qc_ma.yaml"
  script: "scripts/qc_ma.R"

rule gsea_run_go:
  wildcard_constraints: gsea = "|".join(GO_GSEA_NAMES)
  input:
    results = f"{OUTPUT_DIR}/deseq2/{{contrast}}_results.tsv.gz",
    ranking_lib = workflow.source_path("scripts/lib/gsea_ranking.R"),
    # ^-- explicitly re-run upon code change
  output:
    gsea_result_rds =
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_result.rds"
  params:
    contrast_name = "{contrast}",
    gsea_name = "{gsea}",
    database = lambda wc: config["gsea"][wc.gsea]["database"],
    ontology = lambda wc: config["gsea"][wc.gsea]["ontology"],
    ranking_stat = lambda wc: config["gsea"][wc.gsea]["ranking_stat"],
    min_set_size = lambda wc: config["gsea"][wc.gsea]["min_set_size"],
    max_set_size = lambda wc: config["gsea"][wc.gsea]["max_set_size"],
  log: f"{OUTPUT_DIR}/logs/gsea_{{contrast}}_{{gsea}}_run.log"
  conda: "envs/gsea_run_go.yaml"
  script: "scripts/gsea_run_go.R"

rule gsea_run_hallmark:
  wildcard_constraints: gsea = "|".join(OTHER_GSEA_NAMES)
  input: 
    results = rules.gsea_run_go.input.results,
    ranking_lib = rules.gsea_run_go.input.ranking_lib,
    # ^-- explicitly re-run upon code change
  output: gsea_result_rds = rules.gsea_run_go.output.gsea_result_rds
  params:
    contrast_name = rules.gsea_run_go.params.contrast_name,
    gsea_name = rules.gsea_run_go.params.gsea_name,
    database = rules.gsea_run_go.params.database,
    ranking_stat = rules.gsea_run_go.params.ranking_stat,
    min_set_size = rules.gsea_run_go.params.min_set_size,
    max_set_size = rules.gsea_run_go.params.max_set_size,
  log: rules.gsea_run_go.log
  conda: "envs/gsea_run_hallmark.yaml"
  script: "scripts/gsea_run_hallmark.R"

def _gene_sets_of_interest_for_gsea(wildcards):
  gsea_config = config["gsea"][wildcards.gsea]
  try:
    return gsea_config["gene_sets_of_interest"]
  except KeyError:
    return None

rule gsea_postprocess_go:
  wildcard_constraints: gsea = "|".join(GO_GSEA_NAMES)
  input:
    gsea_result_rds = rules.gsea_run_go.output.gsea_result_rds,
    plot_theme_lib = rules.qc_pca.input.plot_theme_lib,
    # ^-- explicitly re-run upon code change
  output:
    gsea_table_all = f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_all.tsv.gz",
    gsea_table_signif = f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_signif.tsv.gz",
    gsea_table_simplified =
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_signif_simplified.tsv.gz",
    gsea_driver_genes =
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_driver_genes.tsv.gz",
    gsea_plot = f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_plot.pdf",
    gsea_ridge_plot =
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_ridge_plot.pdf",
    gsea_lollipop_plot =
      f"{OUTPUT_DIR}/gsea/{{contrast}}_{{gsea}}_gsea_lollipop_plot.pdf",
  params:
    contrast_name = rules.gsea_run_go.params.contrast_name,
    gsea_name = rules.gsea_run_go.params.gsea_name,
    database = rules.gsea_run_go.params.database,
    padj_threshold = lambda wc: config["gsea"][wc.gsea]["padj_threshold"],
    gene_sets_of_interest = _gene_sets_of_interest_for_gsea,
    color_down = config["gsea_plots"]["colors"]["direction"]["down"],
    color_none = config["gsea_plots"]["colors"]["direction"]["none"],
    color_up = config["gsea_plots"]["colors"]["direction"]["up"],
    lollipop_size = config["gsea_plots"]["lollipop_plot"]["size"],
  log: f"{OUTPUT_DIR}/logs/gsea_{{contrast}}_{{gsea}}_postprocess.log"
  conda: "envs/gsea_postprocess_go.yaml"
  script: "scripts/gsea_postprocess.R"

use rule gsea_postprocess_go as gsea_postprocess_hallmark with:
  wildcard_constraints: gsea = "|".join(OTHER_GSEA_NAMES)
  output:
    gsea_table_all = rules.gsea_postprocess_go.output.gsea_table_all,
    gsea_table_signif = rules.gsea_postprocess_go.output.gsea_table_signif,
    gsea_driver_genes = rules.gsea_postprocess_go.output.gsea_driver_genes,
    gsea_plot = rules.gsea_postprocess_go.output.gsea_plot,
    gsea_ridge_plot = rules.gsea_postprocess_go.output.gsea_ridge_plot,
    gsea_lollipop_plot = rules.gsea_postprocess_go.output.gsea_lollipop_plot,
  conda: "envs/gsea_postprocess_hallmark.yaml"

rule aggregate_gsea:
  input:
    lambda wc: expand(
      rules.gsea_postprocess_go.output.gsea_table_all,
      contrast=CONTRAST_NAMES, gsea=wc.gsea
    )
  output:
    summary_table = f"{OUTPUT_DIR}/gsea/{{gsea}}_gsea_summary.tsv.gz",
    heatmap = f"{OUTPUT_DIR}/gsea/{{gsea}}_gsea_summary_heatmap.pdf",
    jaccard = f"{OUTPUT_DIR}/gsea/{{gsea}}_gsea_jaccard.tsv.gz",
  params:
    contrast_names = CONTRAST_NAMES,
    gsea_name = rules.gsea_postprocess_go.params.gsea_name,
    padj_threshold = rules.gsea_postprocess_go.params.padj_threshold,
    gene_sets_of_interest =
      rules.gsea_postprocess_go.params.gene_sets_of_interest,
    heatmap_top_n = HEATMAP_TOP_N
  log: f"{OUTPUT_DIR}/logs/gsea_{{gsea}}_aggregate.log"
  conda: "envs/gsea_summary.yaml"
  script: "scripts/gsea_summary.R"
